# Jolpica F1 API (Ergast-compatible) — no key required
VITE_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# OpenF1 API — no key required
VITE_OPENF1_BASE_URL=https://api.openf1.org/v1

# News API for paddock stories. NewsAPI.org is used by default —
# create a free key at https://newsapi.org/register
# NOTE: NewsAPI's free tier blocks browser-origin requests in production,
# so for a deployed build proxy this through your own serverless function.
VITE_NEWS_API_KEY=your_newsapi_key_here
VITE_NEWS_API_BASE_URL=https://newsapi.org/v2
